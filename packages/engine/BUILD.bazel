load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//packages/engine:typescript/package_json.bzl", tsc = "bin")
load("@npm//packages/engine:wrangler/package_json.bzl", wrangler = "bin")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//bazel:checks.bzl", "tsc_test", "workspace_configs")
load("//bazel:host_run.bzl", "host_run")
load("//bazel:paths.bzl", "bin_relative")

npm_link_all_packages(name = "node_modules")

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "wrangler.jsonc",
        "vitest.config.mts",
        "vitest.e2e.config.mts",
    ],
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "package_json",
    srcs = ["package.json"],
    visibility = ["//scripts:__pkg__"],
)

copy_to_bin(
    name = "public",
    srcs = glob(["public/**"], exclude = ["public/inspector/**", "public/rbi/**"]),
    visibility = [
        "//packages/engine/test/e2e:__pkg__",
        "//packages/node:__pkg__",
        "//tests/pw:__pkg__",
        "//tests/wpt:__pkg__",
    ],
)

filegroup(
    name = "fonts",
    srcs = glob(["public/fonts/**"]),
    visibility = ["//packages/core:__pkg__"],
)

filegroup(
    name = "fixture_assets",
    srcs = glob(["test/fixtures-worker/assets/**"]),
    visibility = ["//packages/core:__pkg__"],
)

# The e2e shards' copies, for tests that import an asset raw: copy_to_bin only copies files of its
# own package, so the shards in test/e2e cannot copy these themselves.
copy_to_bin(
    name = "e2e_fixture_assets",
    srcs = glob(["test/fixtures-worker/assets/**"]),
    visibility = ["//packages/engine/test/e2e:__pkg__"],
)

filegroup(
    name = "overlay_e2e_fixture_assets",
    srcs = glob(["test/fixtures-worker/assets/**"]),
    visibility = ["//packages/engine/test/e2e:__pkg__"],
)

js_library(
    name = "config",
    srcs = [":package_json", "tsconfig.json", "wrangler.jsonc"],
)

js_library(
    name = "srcs",
    srcs = glob(["src/**"]),
    deps = [
        ":config",
        ":node_modules/@kitesurf/dom-shim",
        ":node_modules/@kitesurf/jsrpc-types",
        ":node_modules/@kitesurf/page-renderer",
        ":node_modules/@kitesurf/page-script",
        ":node_modules/@kitesurf/script-gate",
        ":node_modules/@kitesurf/worker-script",
        ":node_modules/devtools-protocol",
        ":node_modules/es-module-lexer",
        ":node_modules/hono",
        ":node_modules/kitesurf-core",
        ":node_modules/nanoid",
        ":node_modules/web-bot-auth",
        ":node_modules/zod",
    ],
)

alias(
    name = "embed",
    actual = ":srcs",
    visibility = ["//visibility:public"],
)

# The npm package target rules_js links into workspace dependents, as in the sibling packages.
alias(
    name = "pkg",
    actual = ":srcs",
    visibility = ["//visibility:public"],
)

copy_file(
    name = "rbi_json",
    src = "//packages/scene-host-wasm:rbi/scene_host.json",
    out = "public/rbi/scene_host.json",
    visibility = ["//packages/kitesurf-cli:__pkg__"],
)

copy_file(
    name = "rbi_wasm",
    src = "//packages/scene-host-wasm:rbi/scene_host.wasm",
    out = "public/rbi/scene_host.wasm",
    visibility = ["//packages/kitesurf-cli:__pkg__"],
)

filegroup(
    name = "rbi",
    srcs = [":rbi_json", ":rbi_wasm"],
    visibility = ["//packages/scene-host-wasm:__pkg__"],
)

# `--config=devtools` (.bazelrc) sets this: the engine assets then serve the prebuilt Chrome
# DevTools frontend at /inspector/, for KITESURF_INSPECTOR_BASE_URL=/inspector/inspector.html.
# Off, @devtools_frontend is never fetched.
bool_flag(
    name = "bundle_devtools",
    build_setting_default = False,
)

config_setting(
    name = "bundle_devtools_enabled",
    flag_values = {":bundle_devtools": "True"},
)

# Empty with the flag off rather than absent: both settings share bazel-bin, where an earlier
# flag-on tree would otherwise outlive the switch.
copy_to_directory(
    name = "inspector",
    srcs = select({
        ":bundle_devtools_enabled": ["@devtools_frontend//:frontend"],
        "//conditions:default": [],
    }),
    out = "public/inspector",
    include_external_repositories = ["*devtools_frontend"],
)

filegroup(
    name = "assets",
    srcs = [":inspector", ":public", ":rbi_json", ":rbi_wasm"],
    visibility = ["//visibility:public"],
)

js_run_binary(
    name = "dist",
    srcs = [
        ":assets",
        ":srcs",
        "//packages/renderer-core:wasm_pkg",
    ],
    out_dirs = ["dist"],
    args = ["prepare", "--dist", bin_relative("packages/engine/dist")],
    mnemonic = "EngineDist",
    progress_message = "Bundling the engine with its public Wrangler config",
    tool = "//scripts:wpt_engine",
    visibility = ["//visibility:public"],
)

# `bazel run` it before `wrangler dev`: copies the built wasm, bundles and RBI files to the
# source-tree paths the dev server reads (scripts/stage-dev-build.mjs).
js_binary(
    name = "dev_build_tool",
    entry_point = "//scripts:stage_dev_build",
)

host_run(
    name = "dev_build",
    data = [
        ":inspector",
        ":rbi_json",
        ":rbi_wasm",
        "//packages/core/pkg:pkg",
        "//packages/dom-shim:pkg",
        "//packages/page-renderer:pkg",
        "//packages/page-script:pkg",
        "//packages/renderer-core:wasm_pkg",
        "//packages/worker-script:pkg",
    ],
    tool = ":dev_build_tool",
)

# `pnpm run deploy` (`bazel run --config=devtools //packages/engine:deploy -- <wrangler deploy args>`)
# uploads :dist and :assets to the account wrangler is logged in to (scripts/engine-deploy.mjs).
# `pnpm run deploy:preview` passes `--preview` first, which uploads a version and moves no traffic.
js_binary(
    name = "deploy",
    data = [
        ":assets",
        ":config",
        ":dist",
        ":node_modules/wrangler",
    ],
    entry_point = "//scripts:engine_deploy",
)

# `bazel run //packages/engine:e2e -- <file-substring>` runs the matching e2e files against the
# Bazel-built engine; with no filter it runs the whole suite (scripts/e2e-run.mjs).
js_binary(
    name = "e2e",
    data = [
        ":dist",
        ":e2e_config",
        ":e2e_fixtures_dist",
        ":e2e_public",
        "//packages/core/pkg:pkg",
        "//packages/engine/test/e2e:helpers",
        "//packages/engine/test/e2e:tests",
    ],
    entry_point = "//scripts:e2e_run",
    # Like :vitest: unpatched, every module resolves through the execroot rather than some
    # through runfiles, which would load vitest twice.
    patch_node_fs = False,
)

alias(
    name = "wpt_dist",
    actual = ":dist",
    visibility = ["//visibility:public"],
)

wrangler.wrangler(
    name = "worker_configuration",
    srcs = ["src/index.ts", ":config"],
    outs = ["worker-configuration.d.ts"],
    args = ["types", "--include-runtime", "--no-strict-vars"],
    chdir = package_name(),
    mnemonic = "WranglerTypes",
)

wrangler.wrangler(
    name = "fixtures_worker_configuration",
    srcs = [
        "test/fixtures-worker/src/index.ts",
        "test/fixtures-worker/wrangler.jsonc",
        ":package_json",
    ],
    outs = ["test/fixtures-worker/worker-configuration.d.ts"],
    args = [
        "types",
        "-c",
        "test/fixtures-worker/wrangler.jsonc",
        "--include-runtime",
        "--no-strict-vars",
        "test/fixtures-worker/worker-configuration.d.ts",
    ],
    chdir = package_name(),
    mnemonic = "WranglerTypes",
)

js_run_binary(
    name = "e2e_fixtures_dist",
    srcs = [
        ":config",
        ":node_modules/hono",
        ":node_modules/zod",
    ] + glob(["test/fixtures-worker/**"]),
    out_dirs = ["e2e_fixtures_dist"],
    args = ["--outdir", bin_relative("packages/engine/e2e_fixtures_dist")],
    mnemonic = "E2eFixturesDist",
    progress_message = "Bundling the e2e fixtures Worker",
    tool = "//scripts:e2e_fixtures",
    visibility = ["//packages/engine/test/e2e:__pkg__"],
)

filegroup(
    name = "e2e_public",
    srcs = [":assets"],
    visibility = ["//packages/engine/test/e2e:__pkg__"],
)

js_library(
    name = "e2e_config",
    srcs = ["vitest.e2e.config.mts"],
    deps = [
        ":config",
        ":node_modules/@cloudflare/puppeteer",
        ":node_modules/@cloudflare/vitest-plugin",
        ":node_modules/miniflare",
        ":node_modules/vitest",
        ":node_modules/web-bot-auth",
        ":node_modules/wrangler",
        ":node_modules/zod",
        "//packages/engine/test/e2e:helpers",
    ],
    visibility = ["//visibility:public"],
)

js_test(
    name = "vitest",
    size = "medium",
    chdir = package_name(),
    data = [
        "vitest.config.mts",
        ":node_modules/@cloudflare/vitest-plugin",
        ":node_modules/vitest",
        ":srcs",
        ":assets",
        "//packages/core/pkg:pkg",
        "//packages/page-script:srcs",
        "//packages/renderer-core:wasm_pkg",
        "//packages/worker-script:srcs",
    ] + glob(["test/*.ts"]),
    entry_point = "//scripts:vitest_bazel",
    # rules_js keeps this process's realpath inside the runfiles tree, but the Workers pool resolves
    # test files to the execroot, so under local execution vitest loaded once per tree. Unpatched,
    # both resolve to the execroot.
    patch_node_fs = False,
    shard_count = 3,
)

_TYPES_DATA = [
    "vitest.config.mts",
    "vitest.e2e.config.mts",
    ":config",
    ":fixtures_worker_configuration",
    ":node_modules/@cloudflare/puppeteer",
    ":node_modules/@cloudflare/vitest-plugin",
    ":node_modules/@types/node",
    ":node_modules/miniflare",
    ":node_modules/vitest",
    ":node_modules/wrangler",
    ":srcs",
    ":worker_configuration",
    "//:node_modules/@cloudflare/workers-types",
    "//packages/core/pkg:pkg",
    "//packages/engine/test/e2e:ts_srcs",
    "//packages/page-script:srcs",
    "//packages/renderer-core:wasm_pkg",
] + glob(["test/**"], exclude = ["**/worker-configuration.d.ts"])

tsc_test(
    name = "types",
    bin = tsc,
    data = _TYPES_DATA,
    size = "medium",
)

tsc_test(
    name = "types_e2e",
    bin = tsc,
    data = _TYPES_DATA,
    project = "test/e2e/tsconfig.json",
    project_in_data = True,
    size = "medium",
)

tsc_test(
    name = "types_e2e_demos",
    bin = tsc,
    data = _TYPES_DATA,
    project = "test/e2e/demos/tsconfig.json",
    project_in_data = True,
    size = "medium",
)

tsc_test(
    name = "types_fixtures_worker",
    bin = tsc,
    data = _TYPES_DATA,
    project = "test/fixtures-worker/tsconfig.json",
    project_in_data = True,
    size = "medium",
)

build_test(name = "build", targets = [":dist"])
workspace_configs()
